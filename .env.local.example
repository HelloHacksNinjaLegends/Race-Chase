# Copy this file to .env.local and fill in your Mapbox token if you want the
# map to load automatically without pasting the token into the app each time.
# Get a free token at https://account.mapbox.com/auth/signup/
#
# This is optional — if you leave it blank, the app will just ask for the
# token once in the browser and remember it there (localStorage) instead.
NEXT_PUBLIC_MAPBOX_TOKEN=
